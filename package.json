{
  "name": "astro-fastify-starter-kit",
  "version": "1.0.0",
  "description": "Full-stack starter kit dengan Astro + React (frontend) dan Fastify (backend)",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && bun run dev",
    "dev:frontend": "cd frontend && bun run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && bun run build",
    "build:frontend": "cd frontend && bun run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && bun run start",
    "start:frontend": "cd frontend && bun run preview",
    "install:all": "cd backend && bun install && cd ../frontend && bun install",
    "clean": "rimraf backend/dist frontend/dist",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd backend && bun run lint",
    "lint:frontend": "cd frontend && bun run lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "rimraf": "^6.0.1"
  },
  "keywords": [
    "astro",
    "react",
    "fastify",
    "typescript",
    "mongodb",
    "fullstack",
    "starter-kit"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/astro-fastify-starter-kit.git"
  }
}