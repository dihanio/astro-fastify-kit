---
import Layout from '../layouts/Layout.astro';
import ApiStatus from '../components/ApiStatus.tsx';
import UserList from '../components/UserList.tsx';
import PartytownDemo from '../components/PartytownDemo.tsx';
import '../styles/global.css';
---

<Layout title="Astro-Fastify Starter Kit" description="Full-stack starter kit dengan Astro + React (frontend) dan Fastify (backend)">
	<div class="container">
		<header class="header fade-in">
			<h1>🚀 Astro-Fastify Starter Kit</h1>
			<p>Full-stack starter kit dengan Astro + React (frontend) dan Fastify (backend)</p>
		</header>

		<main>
			<div class="main-grid">
				<section class="card fade-in">
					<ApiStatus client:load />
				</section>

				<section class="card fade-in">
					<UserList client:load />
				</section>
			</div>

			<section class="card fade-in" style="margin-top: 2rem;">
				<PartytownDemo client:load />
			</section>
		</main>

		<footer class="text-center mb-2 fade-in">
			<p style="color: white; opacity: 0.8; margin-top: 2rem;">
				Built with ❤️ using Astro, React, Fastify, MongoDB, and Partytown
			</p>
		</footer>
	</div>
</Layout></p>
